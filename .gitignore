# ============================================================
# Unity 2021.x and earlier - .gitignore
# ============================================================

# ------------------------------------------------------------
# Unity generated folders
# ------------------------------------------------------------

[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# Memory captures / profiling
[Mm]emoryCaptures/

# Asset Store tools cache
[Aa]ssets/[Aa]sset[Ss]tore[Tt]ools*/


# ------------------------------------------------------------
# Unity generated files
# ------------------------------------------------------------

# Autogenerated solution/project files
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd

# Unity VS / Rider generated files
*.pidb.meta
*.pdb
*.mdb

# Crash reports
sysinfo.txt

# Unity generated debug files
*.stacktrace


# ------------------------------------------------------------
# Visual Studio
# ------------------------------------------------------------

.vs/

# Visual Studio Code
.vscode/

# Visual Studio / MonoDevelop / JetBrains
.idea/

# Rider
*.sln.iml

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper*
*.DotSettings.user

# Visual Studio user-specific files
*.user
*.userosscache
*.sln.docstates


# ------------------------------------------------------------
# OS generated files
# ------------------------------------------------------------

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# macOS Finder metadata
.DocumentRevisions-V100/
.fseventsd/
.Spotlight-V100/
.TemporaryItems/
.Trashes/
.VolumeIcon.icns

# Linux
*~
.directory
.Trash-*
.nfs*


# ------------------------------------------------------------
# Unity / Package Manager
# ------------------------------------------------------------

# Package Manager cache
[Pp]ackages/[Cc]ache/

# Package Manager generated files
[Pp]ackages/[Uu]nity[Rr]egistry[Tt]emplate/[Ll]og/

# Ignore local package development artifacts
[Pp]ackages/*/[Bb]in/
[Pp]ackages/*/[Oo]bj/


# ------------------------------------------------------------
# Unity Local History / backups
# ------------------------------------------------------------

# Unity backup files
*.bak

# Temporary Unity files
*.tmp


# ------------------------------------------------------------
# Build output
# ------------------------------------------------------------

# Common build folders
[Bb]uild/
[Bb]uilds/
[Dd]ist/

# Platform-specific builds
/[Bb]uild/
/[Bb]uilds/
/[Dd]ist/

# Android
*.apk
*.aab

# iOS
*.ipa

# Windows
*.exe
*.app

# WebGL
/[Bb]uild/[Ww]ebGL/
/[Bb]uild/[Ww]ebGL2/

# Linux
*.x86
*.x86_64

# macOS
*.app

# Crash dumps
*.dmp


# ------------------------------------------------------------
# Addressables
# ------------------------------------------------------------

# Addressables build output
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/[Aa]sse[Tt]s/[Bb]uild[Ll]ocator*

# Addressables content state files
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/[Cc]ontent[Ss]tate*.bin


# ------------------------------------------------------------
# Burst / Jobs generated files
# ------------------------------------------------------------

[Bb]urst[Dd]ebugger/
[Bb]urst[Cc]ache/

# Unity Burst generated files
[Bb]urstGg]enerated/
[Bb]urstGg]enerated/


# ------------------------------------------------------------
# IL2CPP generated files
# ------------------------------------------------------------

[Ii]l2cpp[Bb]uild/
[Ii]l2cpp[Bb]uildCache/
[Ii]l2cpp[Dd]ebug/


# ------------------------------------------------------------
# Android / Gradle
# ------------------------------------------------------------

.gradle/
.gradle-cache/

# Unity Android generated Gradle project
/[Bb]uild/[Aa]ndroid/
/[Bb]uild/[Aa]ndroid[Ss]tudio/

# Android Studio
.externalNativeBuild/
.cxx/

# Local Android configuration
local.properties


# ------------------------------------------------------------
# Xcode
# ------------------------------------------------------------

# Xcode user data
xcuserdata/

# Xcode generated data
*.xcuserstate
DerivedData/

# Xcode build products
*.xcarchive


# ------------------------------------------------------------
# Unity Test Framework
# ------------------------------------------------------------

[Tt]est[Rr]esults/
[Nn]unit[Rr]esults/
[Tt]est[Rr]esults.xml


# ------------------------------------------------------------
# Coverage
# ------------------------------------------------------------

[Cc]overage/
*.coverage
*.coveragexml


# ------------------------------------------------------------
# Profiler
# ------------------------------------------------------------

[Pp]rofiler/
*.data
*.data.gz


# ------------------------------------------------------------
# Logs
# ------------------------------------------------------------

*.log
*.log.gz


# ------------------------------------------------------------
# Temporary / generated files
# ------------------------------------------------------------

*.orig
*.rej
*.swp
*.swo
*.pid
*.pid.lock

# Vim
[._]*.s[a-v][a-z]
[._]*.sw[a-p]

# Emacs
*~
\#*\#
/[#]*
.~lock.*


# ------------------------------------------------------------
# Plastic SCM / Unity Version Control
# ------------------------------------------------------------

.plastic/
plastic4/
.ignore/


# ------------------------------------------------------------
# JetBrains Rider
# ------------------------------------------------------------

.idea/
*.sln.iml


# ------------------------------------------------------------
# Generated documentation
# ------------------------------------------------------------

[Dd]ocs/[Bb]uild/
[Dd]ocs/_build/


# ------------------------------------------------------------
# Keep important Unity project files
# ------------------------------------------------------------

# IMPORTANT:
# Do NOT ignore:
#
# Assets/
# Packages/
# ProjectSettings/
#
# These folders contain the actual Unity project data
# and should normally be committed to Git.
